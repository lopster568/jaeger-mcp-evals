# Fixture pins for the jaeger-mcp-evals overlay, 2026-09-10. Overrides demo .env.
# DEMO_VERSION is what compose.yaml actually uses for service images; the demo
# .env at tag 3.0.0 leaves it at "latest", so this line is what makes the pin real.
DEMO_VERSION=3.0.0
# Bootstrap pin: Jaeger 2.23.0 (2026-11-05), the release the fixture boots. It takes the same
# MCP config key (jaeger_query.ai.mcp, #9194) as every main-lineage image make measure builds.
JAEGERTRACING_IMAGE=quay.io/jaegertracing/jaeger:2.23.0
