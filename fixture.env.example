# Copy to fixture.env (gitignored) and fill in. Any key can be overridden by an
# environment variable of the same name. Python reads this with harness/config.py;
# bash scripts source it.

# Host serving Jaeger and flagd over HTTP; localhost when the demo runs on this machine.
FIXTURE_HOST=localhost
# Leave empty to run the demo on this machine; set a user to reach a remote host over key-based ssh.
FIXTURE_SSH_USER=
# OTel demo checkout: absolute, or relative to the home directory, in both modes.
FIXTURE_DEMO_DIR=~/otel-demo-3.0.0
# flagd file the demo reads, relative to FIXTURE_DEMO_DIR. The only file a batch edits.
FIXTURE_FLAG_FILE=src/flagd/demo.flagd.json
# Pristine copy restored after every scenario, relative to FIXTURE_DEMO_DIR.
FIXTURE_PRISTINE_FLAG_FILE=overlay/demo.flagd.json.pristine
# Jaeger query/UI port on the fixture host.
JAEGER_UI_PORT=16686
# Jaeger UI base path; the MCP endpoint is <base>/api/ai/mcp/.
JAEGER_BASE_PATH=/jaeger/ui
# flagd OFREP port, used to confirm a flag flip took effect.
OFREP_PORT=8016
# Phoenix (the trajectory store, compose profile "store") host port on FIXTURE_HOST; bench.py export posts here.
PHOENIX_PORT=16006
# Pre-flight fails if fewer containers than this are running on the fixture.
MIN_CONTAINERS=25
# Local jaeger checkout used by fixture/build-variant.sh.
JAEGER_SRC=../jaeger
# Space-separated tag=commit pairs used to resolve jaeger_commit for release images.
KNOWN_COMMITS=quay.io/jaegertracing/jaeger:2.20.0=798e4b0fcf22609e381df764a01461affd813e1e
# Where trajectories (stream.jsonl, stderr, per-cell files) are written, relative to the repo
# root or absolute. They stay out of git; the batch-level records are copied to records/.
RUNS_DIR=runs
# Anthropic API key for run.client api with provider anthropic. Never recorded.
ANTHROPIC_API_KEY=
# Key for provider openai (any OpenAI-compatible endpoint); the name the OpenAI SDK reads. Never recorded.
OPENAI_API_KEY=
# Base URL for provider openai, up to /v1 (e.g. http://localhost:11434/v1 for Ollama); recorded only as "set", never the URL.
OPENAI_BASE_URL=
# Command that runs the Codex CLI for run.client codex; set to a wrapper to route it through a proxy.
CODEX_BIN=codex
