# Copy to fixture.env (gitignored) and fill in. Any key can be overridden by an
# environment variable of the same name. Python reads this with harness/config.py;
# bash scripts source it.

# Host serving Jaeger and flagd over HTTP; localhost when the demo runs on this machine, a loopback alias
# served by fixture/forward.sh for a remote fixture (fixture/FIXTURE.md, Remote host).
FIXTURE_HOST=localhost
# Address the fixture host publishes Jaeger, flagd and Phoenix on; empty means 127.0.0.1. Set 0.0.0.0 on a firewalled
# host to let the agent machine use the host's address as FIXTURE_HOST without fixture/forward.sh (fixture/FIXTURE.md).
# Set it the same on both machines: the agent machine passes it to compose commands it runs over ssh.
FIXTURE_BIND=
# Leave empty to run the demo on this machine; set a user to reach a remote host over key-based ssh.
FIXTURE_SSH_USER=
# 1 on a fixture host that runs no agent: preflight skips the agent client check and setup skips the Goose image. Leave 0 where the agent runs;
# make smoke ignores it.
FIXTURE_HOST_ONLY=0
# Client make smoke (and make setup's Goose image pull) follows: goose (GOOSE_PROVIDER, GOOSE_MODEL and that
# provider's key below) or cli (the Claude Code CLI). make smoke CLIENT=cli overrides it for one run.
SMOKE_CLIENT=goose
# OTel demo checkout: absolute, or relative to the home directory, in both modes.
FIXTURE_DEMO_DIR=~/otel-demo-3.0.0
# Jaeger query/UI port on the fixture host.
JAEGER_UI_PORT=16686
# flagd OFREP port, used to confirm a flag flip took effect.
OFREP_PORT=8016
# Phoenix (the trajectory store, compose profile "store") host port on FIXTURE_HOST; bench.py export posts here.
PHOENIX_PORT=16006
# Where trajectories (stream.jsonl, stderr, per-cell files) are written, relative to the repo
# root or absolute. They stay out of git; the batch-level records are copied to records/.
RUNS_DIR=runs
# Anthropic API key that run.bill_api_key bills (cli client and grader) instead of the logged-in plan, and that the
# goose client bills with run.provider anthropic. Never recorded.
ANTHROPIC_API_KEY=
# OpenRouter API key the goose client bills with run.provider openrouter. Never recorded; the leak scans look for it.
OPENROUTER_API_KEY=
# Provider (anthropic or openrouter) and model id for the goose client: make measure writes them into its pair file,
# make smoke into its experiment, and the goose grader falls back to them. A batch takes its settings from the experiment file.
GOOSE_PROVIDER=
GOOSE_MODEL=
# Command that runs the Codex CLI for run.client codex; set to a wrapper to route it through a proxy.
CODEX_BIN=codex
# Client that grades every mechanism answer: goose (default; Docker, the pinned Goose image and the provider's API
# key above) or cli (the Claude Code CLI).
# The grader decides every mechanism score: use the agent's model or a stronger reasoning model.
GRADER_CLIENT=goose
# Goose grader: provider (anthropic or openrouter); empty falls back to GOOSE_PROVIDER.
GRADER_PROVIDER=
# Grader model by full id; changing it re-grades (the cache key holds it). Goose grader: empty falls back to GOOSE_MODEL,
# there is no default. cli grader: empty means claude-fable-5-1.
GRADER_MODEL=
# cli grader only: command that runs it; it must accept the Claude Code CLI's -p arguments (a wrapper script works).
GRADER_BIN=claude
