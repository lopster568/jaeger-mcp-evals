# ===== REQUIRED: the Goose agent, as in the Jaeger AI Assistant demo =====
GOOSE_PROVIDER=              # anthropic or openrouter
GOOSE_MODEL=                 # full model id of that provider
ANTHROPIC_API_KEY=           # set the key of GOOSE_PROVIDER, leave the other empty
OPENROUTER_API_KEY=

# ===== OPTIONAL: grader (docs/TUNING.md, Grader) =====
#GRADER_CLIENT=goose         # goose or cli (Claude Code CLI)
#GRADER_PROVIDER=            # empty: same as GOOSE_PROVIDER
#GRADER_MODEL=               # empty: same as GOOSE_MODEL; claude-fable-5-1 for the cli grader
#GRADER_BIN=claude           # cli grader command

# ===== OPTIONAL: other agent clients (docs/USAGE.md, Clients) =====
#SMOKE_CLIENT=goose          # client of make smoke: goose or cli
#CODEX_BIN=codex             # command for run.client codex

# ===== OPTIONAL: fixture on another machine (fixture/FIXTURE.md, Remote host) =====
#FIXTURE_HOST=localhost
#FIXTURE_SSH_USER=           # set to reach the fixture host over ssh
#FIXTURE_BIND=127.0.0.1      # same value on both machines
#FIXTURE_HOST_ONLY=0         # 1 on a fixture host that runs no agent

# ===== OPTIONAL: paths and ports =====
#FIXTURE_DEMO_DIR=~/otel-demo-3.0.0
#RUNS_DIR=runs
#JAEGER_UI_PORT=16686
#OFREP_PORT=8016
#PHOENIX_PORT=16006
